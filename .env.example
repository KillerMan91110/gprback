# Configura tu conexión PostgreSQL
DATABASE_URL=postgresql://usuario:contraseña@localhost:5432/gpr_db
# Si necesitas usar otra variable de entorno
PG_CONNECTION_STRING=postgresql://usuario:contraseña@localhost:5432/gpr_db

# Orígenes permitidos para CORS (front en Vercel / dominio propio), separados por coma
ALLOWED_ORIGINS=https://gpr-orpin.vercel.app
